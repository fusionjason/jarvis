# Public URL Twilio can reach (use an ngrok/cloudflared tunnel in development)
PUBLIC_BASE_URL=https://your-tunnel.example.com
DATABASE_URL=sqlite:///./assistant.db

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555550123
# Set to false only for local testing without real Twilio requests
TWILIO_VALIDATE_SIGNATURES=true

# SMTP (SendGrid, Postmark, Mailgun, SES, Google Workspace...). Leave SMTP_HOST empty for dry-run.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=assistant@youragency.com
REPLY_TO_EMAIL=agent@youragency.com

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_REALTIME_VOICE=alloy

AGENCY_NAME=Your Agency
# Required in every marketing email by CAN-SPAM
AGENCY_MAILING_ADDRESS=123 Main St, Suite 100, Anytown, ST 12345
ASSISTANT_NAME=Avery
LICENSED_AGENT_NAME=a licensed agent

CALL_WINDOW_START_HOUR=8
CALL_WINDOW_END_HOUR=21
MAX_CONTACT_ATTEMPTS=6
RECORD_CALLS=true
